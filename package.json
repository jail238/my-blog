{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:planner-config": "node scripts/check-planner-config.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "pin:circle-plus": "node scripts/sync-maishift-records.mjs --write-circle-plus-snapshot",
    "pin:circle-plus:candidate": "node scripts/sync-maishift-records.mjs --write-circle-plus-snapshot --catalog-candidate",
    "sync:catalog:candidate": "node scripts/sync-maimai-catalog.mjs --allow-catalog-changes",
    "sync:catalog": "node scripts/sync-maimai-catalog.mjs",
    "sync:records": "node scripts/sync-maishift-records.mjs",
    "sync:data": "npm run sync:catalog && npm run sync:records",
    "refresh:catalog": "npm run sync:catalog:candidate && npm run pin:circle-plus:candidate && npm run sync:catalog"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.52.0",
    "@supabase/supabase-js": "2.117.3",
    "astro": "^7.0.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "fontkit": "^2.0.4",
    "js-yaml": "4.3.2"
  }
}
