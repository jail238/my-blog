---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	<nav>
		<a class="site-brand" href={`${base}/`}>
			<strong>{SITE_TITLE}</strong>
		</a>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>홈</HeaderLink>
			<HeaderLink href={`${base}/levels/`}>레벨</HeaderLink>
			<HeaderLink href={`${base}/difficulties/`}>난이도</HeaderLink>
			<HeaderLink href={`${base}/versions/`}>버전</HeaderLink>
			<HeaderLink href={`${base}/plates/`}>플레이트</HeaderLink>
		</div>
	</nav>
</header>
<style>
	.site-header {
		background: #ffffff;
		border-bottom: 1px solid #eef1f2;
		box-shadow: 0 2px 4px rgba(33, 56, 41, 0.025), 0 8px 22px rgba(33, 56, 41, 0.05);
		margin: 0;
		padding: 0 2rem;
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1180px;
		min-height: 80px;
	}
	.site-brand {
		align-items: baseline;
		color: rgb(var(--text));
		display: flex;
		gap: 0.65rem;
		text-decoration: none;
	}
	.site-brand strong {
		font-size: 1.5rem;
		font-weight: 800;
	}
	.site-brand small {
		color: rgb(var(--muted));
		font-size: 0.66rem;
		font-weight: 760;
	}
	.internal-links {
		align-items: center;
		display: flex;
		gap: 0.5rem;
	}
	nav a {
		color: rgb(var(--muted));
		border-radius: 6px;
		font-size: 0.94rem;
		font-weight: 500;
		padding: 0.6rem 1rem;
		position: relative;
		text-decoration: none;
		transition: color 140ms ease;
	}
	nav a:hover,
	nav a.active {
		color: var(--brand-strong);
		text-decoration: none;
	}
	.internal-links :global(a.active)::after {
		content: none;
	}
	.internal-links :global(a.active) {
		background: var(--brand-soft);
		color: var(--brand-strong);
	}
	@media (max-width: 720px) {
		.site-header {
			padding: 0 0.9rem;
		}
		nav {
			min-height: 64px;
		}
		.site-brand small {
			display: none;
		}
		.internal-links {
			gap: 0.15rem;
		}
		nav a {
			font-size: 0.76rem;
			padding: 0.55rem 0.5rem;
		}
		.site-brand strong { font-size: 1.2rem; }
	}
	@media (max-width: 360px) {
		.site-header { padding: 0 0.75rem; }
		nav a { padding-inline: 0.35rem; }
	}
</style>
