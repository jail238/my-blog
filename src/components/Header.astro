---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	<nav>
		<a class="site-brand" href={`${base}/`}>
			<strong>{SITE_TITLE}</strong>
			<small>MISAKI ARCHIVE</small>
		</a>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>홈</HeaderLink>
			<HeaderLink href={`${base}/levels/`}>레벨 순</HeaderLink>
			<HeaderLink href={`${base}/versions/`}>버전 순</HeaderLink>
		</div>
	</nav>
</header>
<style>
	.site-header {
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid rgb(var(--line));
		margin: 0;
		padding: 0 1.25rem;
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1180px;
		min-height: 64px;
	}
	.site-brand {
		align-items: baseline;
		color: rgb(var(--text));
		display: flex;
		gap: 0.65rem;
		text-decoration: none;
	}
	.site-brand strong {
		font-size: 1rem;
		font-weight: 820;
	}
	.site-brand small {
		color: rgb(var(--muted));
		font-size: 0.66rem;
		font-weight: 760;
	}
	.internal-links {
		align-items: center;
		display: flex;
		gap: 1.4rem;
	}
	nav a {
		color: rgb(var(--muted));
		font-size: 0.86rem;
		font-weight: 700;
		padding: 1.2rem 0;
		position: relative;
		text-decoration: none;
		transition: color 140ms ease;
	}
	nav a:hover,
	nav a.active {
		color: rgb(var(--text));
		text-decoration: none;
	}
	.internal-links :global(a.active)::after {
		background: rgb(var(--text));
		bottom: -1px;
		content: '';
		height: 2px;
		left: 0;
		position: absolute;
		width: 100%;
	}
	@media (max-width: 720px) {
		.site-header {
			padding: 0 0.9rem;
		}
		nav {
			min-height: 58px;
		}
		.site-brand small {
			display: none;
		}
		.internal-links {
			gap: 1rem;
		}
		nav a {
			font-size: 0.8rem;
			padding: 1.05rem 0;
		}
	}
</style>
