---
import { Menu, X } from '@lucide/astro';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	{ path: '/', label: 'Home' },
	{ path: '/levels/', label: 'Level' },
	{ path: '/difficulties/', label: 'Difficulty' },
	{ path: '/versions/', label: 'Version' },
	{ path: '/plates/', label: 'Plate' },
	{ path: '/hall-of-fame/', label: 'Hall of Fame' },
	{ path: '/planner/', label: 'Planner' },
];
---

<header class="site-header" data-site-header>
	<nav aria-label="Primary">
		<button
			type="button"
			class="mobile-menu-toggle navigation-icon-button"
			data-mobile-navigation-toggle
			aria-label="Open navigation"
			aria-controls="mobile-navigation-dialog"
			aria-haspopup="dialog"
			aria-expanded="false"
			title="Open navigation"
		>
			<Menu size={22} aria-hidden="true" />
		</button>
		<a class="site-brand" href={`${base}/`}>
			<strong>{SITE_TITLE}</strong>
		</a>
		<div class="internal-links">
			{links.map((link) => <HeaderLink href={`${base}${link.path}`}>{link.label}</HeaderLink>)}
		</div>
	</nav>
</header>

<dialog class="mobile-navigation" id="mobile-navigation-dialog" aria-label="Navigation">
	<div class="mobile-navigation-heading">
		<strong>{SITE_TITLE}</strong>
		<button type="button" class="navigation-icon-button" data-mobile-navigation-close aria-label="Close navigation" title="Close navigation">
			<X size={22} aria-hidden="true" />
		</button>
	</div>
	<nav class="mobile-navigation-links" aria-label="Mobile">
		{links.map((link) => <HeaderLink href={`${base}${link.path}`}>{link.label}</HeaderLink>)}
	</nav>
</dialog>

<script>
	import { initMobileNavigation } from '../scripts/mobile-navigation.js';
	initMobileNavigation();
</script>

<style>
	.site-header {
		background: #ffffff;
		border-bottom: 1px solid #eeeeee;
		box-shadow: 0 2px 4px rgba(32, 32, 32, 0.025), 0 8px 22px rgba(32, 32, 32, 0.05);
		margin: 0;
		padding: 0 2rem;
		position: sticky;
		top: 0;
		z-index: 20;
	}
	.site-header > nav {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1180px;
		min-height: 80px;
	}
	.site-brand {
		align-items: baseline;
		color: rgb(var(--text));
		display: flex;
		gap: 0.65rem;
		text-decoration: none;
	}
	.site-brand strong {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
	}
	.site-brand small {
		color: rgb(var(--muted));
		font-size: 0.66rem;
		font-weight: 760;
	}
	.internal-links {
		align-items: center;
		display: flex;
		gap: 0.5rem;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.internal-links :global(a) { flex-shrink: 0; white-space: nowrap; }
	.site-header :global(a), .mobile-navigation-links :global(a) {
		color: rgb(var(--muted));
		border-radius: 6px;
		font-size: 0.94rem;
		font-weight: 500;
		padding: 0.6rem 1rem;
		position: relative;
		text-decoration: none;
		transition: color 140ms ease;
	}
	.site-header :global(a:hover),
	.mobile-navigation-links :global(a:hover) {
		color: var(--brand-strong);
		text-decoration: none;
	}
	.internal-links :global(a.active)::after, .mobile-navigation-links :global(a.active)::after {
		content: none;
	}
	.internal-links :global(a.active), .mobile-navigation-links :global(a.active) {
		background: var(--brand-soft);
		color: var(--brand-strong);
	}
	.navigation-icon-button {
		align-items: center;
		background: transparent;
		border: 1px solid rgb(var(--line));
		border-radius: 6px;
		color: rgb(var(--text));
		display: inline-flex;
		flex: 0 0 44px;
		height: 44px;
		justify-content: center;
		padding: 0;
		width: 44px;
	}
	.navigation-icon-button:hover { background: var(--brand-soft); }
	.mobile-menu-toggle { display: none; }
	.mobile-navigation {
		background: var(--surface);
		border: 0;
		border-radius: 0;
		box-shadow: 8px 0 32px #0000001f;
		color: rgb(var(--text));
		height: 100vh;
		height: 100dvh;
		inset: 0 auto 0 0;
		margin: 0;
		max-height: none;
		max-width: none;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 20px 18px;
		position: fixed;
		width: min(304px, calc(100% - 48px));
	}
	.mobile-navigation[open] { animation: navigation-enter 160ms ease-out; }
	.mobile-navigation::backdrop { background: #20202066; }
	.mobile-navigation-heading { align-items: center; display: flex; justify-content: space-between; }
	.mobile-navigation-heading strong { font-family: var(--font-display); font-size: 22px; }
	.mobile-navigation-links { display: flex; flex-direction: column; gap: 6px; margin-top: 24px; }
	.mobile-navigation-links :global(a) { font-size: 15px; min-height: 48px; padding: 12px 14px; }
	:global(html:has(#mobile-navigation-dialog[open])) { overflow: hidden; scrollbar-gutter: stable; }
	@keyframes navigation-enter { from { transform: translateX(-100%); } to { transform: translateX(0); } }
	@media (prefers-reduced-motion: reduce) { .mobile-navigation[open] { animation: none; } }
	@media (max-width: 720px) {
		.site-header {
			padding: 0 0.9rem;
		}
		.site-header > nav {
			gap: 12px;
			min-height: 64px;
		}
		.site-brand small {
			display: none;
		}
		.internal-links {
			flex-wrap: wrap;
			gap: 4px;
			overflow: visible;
		}
		.site-header :global(a) {
			font-size: 0.76rem;
			padding: 0.55rem 3px;
		}
		.site-brand { flex-shrink: 0; padding-left: 0; }
		.site-brand strong { font-size: 1.2rem; }
		.site-header[data-mobile-navigation='ready'] > nav { justify-content: flex-start; }
		.site-header[data-mobile-navigation='ready'] .mobile-menu-toggle { display: inline-flex; }
		.site-header[data-mobile-navigation='ready'] .internal-links { display: none; }
	}
	@media (max-width: 360px) {
		.site-header { padding: 0 0.75rem; }
		.site-brand strong { font-size: 17px; }
	}
</style>
