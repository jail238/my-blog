---
import { Play, ArrowUpRight, Clapperboard } from '@lucide/astro';
import type { Chart, ChartType } from '../data/maimai';
import { versionById } from '../data/maimai';
import { getDxScoreStarCount } from '../utils/maimai-dx-score.js';
import { formatKstDate } from '../utils/maimai-record-date.js';
import { buildMaimaiYoutubeQuery, buildMaimaiYoutubeUrl } from '../utils/maimai-youtube.js';
import { isPerfectRecord } from '../utils/perfect-videos.js';
import '../styles/perfect-videos.css';

interface Props {
	type: ChartType;
	charts: Chart[];
	songTitle: string;
}

const { type, charts, songTitle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const typeLabel = type === 'STANDARD' ? 'ST' : 'DX';
const difficultyOrder: Record<Chart['difficulty'], number> = {
	BASIC: 0,
	ADVANCED: 1,
	EXPERT: 2,
	MASTER: 3,
	'Re:MASTER': 4,
};
const sortedCharts = [...charts].sort((a, b) => difficultyOrder[a.difficulty] - difficultyOrder[b.difficulty]);
const chartVersions = [...new Set(sortedCharts.map((chart) => chart.versionId))]
	.map((versionId) => versionById.get(versionId))
	.filter((version) => version !== undefined);
const comboIcons: Record<string, { file: string; label: string }> = {
	FC: { file: 'fc.webp', label: 'FULL COMBO' },
	'FC+': { file: 'fcp.webp', label: 'FULL COMBO+' },
	AP: { file: 'ap.webp', label: 'ALL PERFECT' },
	'AP+': { file: 'app.webp', label: 'ALL PERFECT+' },
};
---

<section class="song-chart-group" aria-labelledby={`song-chart-${type.toLowerCase()}`}>
	<header class="song-chart-group-heading">
		<h3 id={`song-chart-${type.toLowerCase()}`}>
			<span class:list={['type-badge', `type-${type.toLowerCase()}`]}>{typeLabel}</span>
			Charts
		</h3>
		<div class="song-chart-group-versions" aria-label={`${typeLabel} chart versions`}>
			{chartVersions.map((version) => (
				<a class="song-chart-version" href={`${base}/versions/${version.id}/`}>{version.shortName}</a>
			))}
		</div>
	</header>

	<div class="song-chart-board-scroll" tabindex="0" role="region" aria-label={`${typeLabel} chart comparison`}>
		<table class="song-chart-board" role="table" style={`--chart-count: ${sortedCharts.length};`}>
			<thead role="rowgroup">
				<tr role="row">
					{sortedCharts.map((chart) => {
						const difficultyClass = chart.difficulty === 'Re:MASTER' ? 'remaster' : chart.difficulty.toLowerCase();
						return <th id={`song-chart-${type.toLowerCase()}-${difficultyClass}`} class:list={['song-chart-difficulty', `difficulty-${difficultyClass}`]} role="columnheader" scope="col">{chart.difficulty}</th>;
					})}
				</tr>
			</thead>
			<tbody role="rowgroup">
				<tr class="song-chart-board-levels" role="row">
					{sortedCharts.map((chart) => (
						<td role="cell" headers={`song-chart-${type.toLowerCase()}-${chart.difficulty === 'Re:MASTER' ? 'remaster' : chart.difficulty.toLowerCase()}`}>
							<strong>{chart.level}</strong>
							<span>{chart.constant?.toFixed(1) ?? '-'}</span>
						</td>
					))}
				</tr>
				<tr class="song-chart-board-records" role="row">
					{sortedCharts.map((chart) => {
						const [achievementWhole, achievementFraction] = chart.record?.achievement.split('.') ?? [];
						const comboIcon = chart.record?.combo ? comboIcons[chart.record.combo] : undefined;
						const dxStars = chart.record
							? getDxScoreStarCount(chart.record.dxScore, chart.record.dxScoreMax)
							: 0;
						const dxStarAssetSize = dxStars === 5 ? 70 : 46;
						const apDate = chart.record?.apAchievedAt
							? formatKstDate(chart.record.apAchievedAt)
							: undefined;
						const apPlusDate = chart.record?.apPlusAchievedAt
							? formatKstDate(chart.record.apPlusAchievedAt)
							: undefined;
						return (
							<td role="cell" headers={`song-chart-${type.toLowerCase()}-${chart.difficulty === 'Re:MASTER' ? 'remaster' : chart.difficulty.toLowerCase()}`}>
								{chart.record ? (
									<div
										class="song-chart-score"
										title={`DX ${chart.record.dxScore}/${chart.record.dxScoreMax}`}
									>
										<div class="song-chart-score-primary">
											<strong>{achievementWhole}{achievementFraction !== undefined && <>.<wbr />{achievementFraction}</>}</strong>
											{comboIcon && (
												<img
													class="combo-icon"
													src={`${base}/assets/maimai/music-icon/${comboIcon.file}`}
													alt={comboIcon.label}
													title={comboIcon.label}
													width="80"
													height="80"
													loading="lazy"
												/>
											)}
										</div>
										<span class="song-chart-status">{chart.record.rank}{chart.record.sync && <> · {chart.record.sync}</>}</span>
										<small
											class="song-chart-dx-score"
											aria-label={`DX ${chart.record.dxScore}/${chart.record.dxScoreMax}, ${dxStars} stars`}
										>
											<span>DX {chart.record.dxScore}/{chart.record.dxScoreMax}</span>
											{dxStars > 0 && (
												<img
													class="song-chart-dx-star"
													src={`${base}/assets/maimai/dx-score/${dxStars}.png`}
													alt=""
													width={dxStarAssetSize}
													height={dxStarAssetSize}
													loading="lazy"
													aria-hidden="true"
												/>
											)}
										</small>
										{apDate && <small class="song-chart-perfect-date"><time datetime={chart.record.apAchievedAt}>{apDate}</time> AP achieved</small>}
										{apPlusDate && <small class="song-chart-perfect-date"><time datetime={chart.record.apPlusAchievedAt}>{apPlusDate}</time> AP+ achieved</small>}
									</div>
								) : (
									<span class="song-chart-score-empty" aria-label="No record">-</span>
								)}
							</td>
						);
					})}
				</tr>
				<tr class="song-chart-board-actions" role="row">
					{sortedCharts.map((chart) => {
						const query = buildMaimaiYoutubeQuery(songTitle, type, chart.difficulty);
						return (
							<td role="cell" headers={`song-chart-${type.toLowerCase()}-${chart.difficulty === 'Re:MASTER' ? 'remaster' : chart.difficulty.toLowerCase()}`}>
								<a
									class="song-chart-youtube"
									href={buildMaimaiYoutubeUrl(songTitle, type, chart.difficulty)}
									target="_blank"
									rel="noreferrer"
									aria-label={`Search YouTube for ${query}`}
									title={query}
								>
									<Play size={15} aria-hidden="true" /><span class="song-chart-youtube-label">YouTube</span><ArrowUpRight class="song-chart-youtube-external" size={13} aria-hidden="true" />
								</a>
								{isPerfectRecord(chart.record) && (
									<div class="song-chart-video-control" data-perfect-video-chart={chart.id} data-combo={chart.record?.combo} data-chart-label={`${songTitle} · ${typeLabel} · ${chart.difficulty}`} hidden>
										<a class="song-chart-ap-video" data-perfect-video-link target="_blank" rel="noopener noreferrer" aria-label={`Watch my AP video: ${songTitle} · ${typeLabel} · ${chart.difficulty}`} title="My AP video" hidden>
											<Clapperboard size={14} aria-hidden="true" /><span class="song-chart-ap-video-label"><span>My AP</span> <span>Video</span></span>
										</a>
									</div>
								)}
							</td>
						);
					})}
				</tr>
			</tbody>
		</table>
	</div>
</section>
