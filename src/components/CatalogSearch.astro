---
import { LayoutGrid, List } from '@lucide/astro';

interface Props {
	id: string;
	targetId: string;
	placeholder: string;
	initialCount: number;
	sortLabel: string;
	emptyMessage: string;
	viewStorageKey?: string;
}

const { id, targetId, placeholder, initialCount, sortLabel, emptyMessage, viewStorageKey } = Astro.props;
const countId = `${id}-count`;
const emptyId = `${id}-empty`;
---

<form
	class="record-filters compact-search-filters"
	id={`${id}-filters`}
	data-list-filter
	data-target={targetId}
	data-count={countId}
	data-empty={emptyId}
	data-view-storage-key={viewStorageKey}
>
	<label class="record-search">
		<span>Search</span>
		<input type="search" placeholder={placeholder} autocomplete="off" />
	</label>
	<button type="reset">Reset</button>
</form>

<div class="record-result-bar" aria-live="polite">
	<strong id={countId}>{initialCount.toLocaleString('en-US')} songs</strong>
	<div class="catalog-result-actions">
		<span>{sortLabel}</span>
		{viewStorageKey && (
			<div class="level-chart-view-toggle" role="group" aria-label="View mode">
				{[{ view: 'list', label: 'List view', Icon: List }, { view: 'grid', label: 'Grid view', Icon: LayoutGrid }].map(({ view, label, Icon }) => (
					<button
						type="button"
						class:list={['level-chart-view-button', { active: view === 'list' }]}
						data-catalog-view={view}
						aria-label={label}
						aria-controls={targetId}
						aria-pressed={view === 'list' ? 'true' : 'false'}
						title={label}
					>
						<Icon size={18} aria-hidden="true" />
					</button>
				))}
			</div>
		)}
	</div>
</div>

<div class="catalog-empty compact" id={emptyId} hidden><strong>{emptyMessage}</strong></div>

<script>
	import { searchMatches } from '../utils/catalog-search.js';

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-list-filter]')) {
		const input = form.querySelector('input[type="search"]');
		const target = document.getElementById(form.dataset.target ?? '');
		const count = document.getElementById(form.dataset.count ?? '');
		const empty = document.getElementById(form.dataset.empty ?? '');

		if (!(input instanceof HTMLInputElement) || !target) continue;
		const rows = [...target.querySelectorAll<HTMLElement>('[data-search]')];
		const viewStorageKey = form.dataset.viewStorageKey;
		const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-catalog-view]')]
			.filter((button) => button.getAttribute('aria-controls') === target.id);

		function applyView(view: 'list' | 'grid', persist = true) {
			target.dataset.view = view;
			for (const button of viewButtons) {
				const active = button.dataset.catalogView === view;
				button.classList.toggle('active', active);
				button.setAttribute('aria-pressed', String(active));
			}
			if (persist && viewStorageKey) {
				try { localStorage.setItem(viewStorageKey, view); } catch {}
			}
		}

		if (viewStorageKey) {
			for (const button of viewButtons) {
				button.addEventListener('click', () => {
					const view = button.dataset.catalogView;
					if (view === 'list' || view === 'grid') applyView(view);
				});
			}
			let initialView: 'list' | 'grid' = 'list';
			try { if (localStorage.getItem(viewStorageKey) === 'grid') initialView = 'grid'; } catch {}
			applyView(initialView, false);
		}

		function applyFilter() {
			const query = input.value;
			const matches = rows.filter((row) => searchMatches(row.dataset.search, query));
			const matchSet = new Set(matches);

			for (const row of rows) row.hidden = !matchSet.has(row);
			target.hidden = matches.length === 0;
			if (count) count.textContent = `${matches.length.toLocaleString('en-US')} songs`;
			if (empty instanceof HTMLElement) empty.hidden = matches.length > 0;
		}

		form.addEventListener('input', applyFilter);
		form.addEventListener('reset', () => requestAnimationFrame(applyFilter));
		applyFilter();
	}
</script>
