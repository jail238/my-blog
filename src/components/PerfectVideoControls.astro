---
import { Check, LogIn, LogOut, RefreshCw, Trash2, X } from '@lucide/astro';
import '../styles/perfect-videos.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="perfect-videos" class="perfect-video-account" data-base={base}>
  <span id="perfect-video-status" role="status"></span>
  <button id="perfect-video-refresh" class="perfect-video-icon" type="button" title="Refresh video links" aria-label="Refresh video links" hidden><RefreshCw size={16} /></button>
  <button id="perfect-video-sign-in" class="perfect-video-button" type="button" hidden><LogIn size={16} />Sign in</button>
  <button id="perfect-video-sign-out" class="perfect-video-icon" type="button" title="Sign out" aria-label="Sign out of video editing" hidden><LogOut size={16} /></button>
</div>

<dialog id="perfect-video-editor" class="perfect-video-dialog" aria-labelledby="perfect-video-title">
  <header><h2 id="perfect-video-title">My AP video</h2><button class="perfect-video-icon" type="button" data-close-video title="Close" aria-label="Close video editor"><X size={18} /></button></header>
  <form id="perfect-video-form">
    <div class="perfect-video-dialog-body">
      <p id="perfect-video-chart"></p>
      <label for="perfect-video-url">YouTube URL</label>
      <input id="perfect-video-url" name="url" type="url" inputmode="url" placeholder="https://youtu.be/..." autocomplete="off" required maxlength="2048" />
      <p id="perfect-video-message" role="status" hidden></p>
      <div id="perfect-video-confirmation" hidden><p>Remove this video link?</p><button id="perfect-video-confirm-remove" class="perfect-video-button" type="button"><Trash2 size={15} />Remove link</button></div>
    </div>
    <footer>
      <button id="perfect-video-remove" class="perfect-video-icon" type="button" title="Remove video link" aria-label="Remove video link" hidden><Trash2 size={16} /></button>
      <button class="perfect-video-button" type="button" data-close-video>Cancel</button>
      <button id="perfect-video-save" class="perfect-video-button primary" type="submit"><Check size={16} />Save</button>
    </footer>
  </form>
</dialog>

<script>
  import { initializePerfectVideos } from '../scripts/perfect-videos';
  initializePerfectVideos();
</script>
