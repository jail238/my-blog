---
import type { Song } from '../data/maimai';

interface Props {
	song: Pick<Song, 'title' | 'artworkUrl'>;
	compact?: boolean;
}

const { song, compact = false } = Astro.props;
const initial = song.title.trim().slice(0, 1).toUpperCase();
---

<span class:list={['song-artwork', { compact }]} aria-hidden="true">
	<span class="song-artwork-fallback">{initial}</span>
	<img
		src={song.artworkUrl}
		alt=""
		loading="lazy"
		decoding="async"
		width={compact ? 44 : 92}
		height={compact ? 44 : 92}
		onerror="this.hidden=true"
	/>
</span>
