---
const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} M.S.K.</span>
	<span>MAIMAI RECORD ARCHIVE</span>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		border-top: 1px solid rgba(var(--line), 90%);
		color: rgb(var(--muted));
		font-size: 0.9rem;
		margin: 3rem auto 0;
		max-width: 960px;
		padding: 1.5rem 1rem 4rem;
		text-align: left;
	}
	@media (max-width: 520px) {
		footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
