---
const today = new Date();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div>
		<a class="footer-brand" href={`${base}/`}>M.S.K.</a>
		<span>&copy; {today.getFullYear()} · MAIMAI RECORD ARCHIVE</span>
	</div>
</footer>
<style>
	footer {
		background: #263238;
		color: #c3cbce;
		padding: 2.5rem 2rem;
	}
	footer > div {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: auto;
		max-width: 1180px;
	}
	.footer-brand {
		color: #ffffff;
		font-size: 1.5rem;
		font-weight: 700;
		text-decoration: none;
	}
	footer span {
		font-size: 0.75rem;
	}
	@media (max-width: 520px) {
		footer { padding: 2rem 1rem; }
		footer > div {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
