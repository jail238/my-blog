---
import type { ChartType, Song } from '../data/maimai';
import SongArtwork from './SongArtwork.astro';

interface Props {
	song: Song;
	chartTypes?: ChartType[];
}

const { song, chartTypes = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
	class="song-row"
	href={`${base}/songs/${song.id}/`}
	data-search={`${song.title} ${song.artist}`.toLocaleLowerCase('ko')}
>
	<SongArtwork song={song} />
	<span>
		<strong>{song.title}</strong>
		<small>{song.artist}</small>
	</span>
	{chartTypes.length > 0 && (
		<span class="song-row-types" aria-label="이 버전에 추가된 채보 유형">
			{chartTypes.map((type) => (
				<b class:list={['type-badge', `type-${type.toLowerCase()}`]}>{type === 'STANDARD' ? 'ST' : 'DX'}</b>
			))}
		</span>
	)}
	<span class="song-row-arrow" aria-hidden="true">›</span>
</a>
