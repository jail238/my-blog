---
import type { Chart, ChartType, Difficulty, Song } from '../data/maimai';
import SongArtwork from './SongArtwork.astro';

interface Props {
	song: Song;
	charts?: Chart[];
}

const { song, charts = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const trackedDifficulties = ['BASIC', 'ADVANCED', 'EXPERT', 'MASTER'] as const satisfies readonly Difficulty[];
const chartGroups = (['STANDARD', 'DX'] as const satisfies readonly ChartType[])
	.map((type) => {
		const typeCharts = charts.filter((chart) => chart.type === type);
		const markers = trackedDifficulties.map((difficulty) => {
			const chart = typeCharts.find((candidate) => candidate.difficulty === difficulty);
			const combo = chart?.record?.combo;
			return {
				difficulty,
				available: chart !== undefined,
				combo,
				perfect: combo === 'AP' || combo === 'AP+',
			};
		});
		return {
			type,
			label: type === 'STANDARD' ? 'ST' : 'DX',
			markers,
			perfectLabel: markers.filter((marker) => marker.perfect).map((marker) => marker.difficulty).join(', ') || '없음',
		};
	})
	.filter((group) => group.markers.some((marker) => marker.available));
---

<a
	class="song-row"
	href={`${base}/songs/${song.id}/`}
	data-search={`${song.title} ${song.artist}`.toLocaleLowerCase('ko')}
>
	<SongArtwork song={song} />
	<span>
		<strong>{song.title}</strong>
		<small>{song.artist}</small>
	</span>
	{chartGroups.length > 0 && (
		<span
			class="song-row-types"
			aria-label={chartGroups.map((group) => `${group.label} AP 이상: ${group.perfectLabel}`).join('; ')}
		>
			{chartGroups.map((group) => (
				<span class="song-row-chart-group">
					<span class="song-perfect-markers" aria-hidden="true">
						{group.markers.map((marker) => (
							<i
								class:list={[
									'song-perfect-marker',
									`perfect-${marker.difficulty.toLowerCase()}`,
									{ 'is-perfect': marker.perfect, 'is-unavailable': !marker.available },
								]}
								title={`${marker.difficulty}: ${marker.available ? (marker.perfect ? marker.combo : '미달성') : '채보 없음'}`}
							/>
						))}
					</span>
					<b class:list={['type-badge', `type-${group.type.toLowerCase()}`]}>{group.label}</b>
				</span>
			))}
		</span>
	)}
	<span class="song-row-arrow" aria-hidden="true">›</span>
</a>
