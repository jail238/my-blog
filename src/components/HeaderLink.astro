---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(base, '') || '/';
const normalizedHref = String(href).replace(base, '') || '/';
const cleanPathname = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
const cleanHref = normalizedHref === '/' ? '/' : normalizedHref.replace(/\/$/, '');
const isActive = cleanHref === cleanPathname || (cleanHref !== '/' && cleanPathname.startsWith(`${cleanHref}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 760;
	}
</style>
