---
import { ArrowUpRight, CalendarPlus, Play } from '@lucide/astro';
import type { RecommendationItem } from '../data/recommendations';
import { STUDY_SKILLS } from '../data/chart-study.js';
import { percentage, plannerRecommendationUrl, recommendationReason } from '../utils/recommendations.js';
import { buildMaimaiYoutubeUrl } from '../utils/maimai-youtube.js';
interface Props { item?: RecommendationItem }
const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const songUrl = item ? `${base}/songs/${item.songId}/` : '#';
const label = item?.title.trim() || 'Untitled';
---
<article class="recommendation-card" data-chart-id={item?.id}>
  <a class="recommendation-artwork" data-slot="artwork-link" href={songUrl} aria-label={label}>
    <img data-slot="artwork" src={item?.artworkUrl} alt="" width="76" height="76" loading="lazy" />
  </a>
  <div class="recommendation-copy">
    <a class="recommendation-title" data-slot="title" href={songUrl} title={label}>{label}</a>
    <small class="recommendation-translation" data-slot="translation" hidden={!item?.koreanTitle}>{item?.koreanTitle}</small>
    <div class="recommendation-chart-meta">
      <span data-slot="type" class:list={['type-badge', `type-${item?.type.toLowerCase()}`]}>{item?.type === 'STANDARD' ? 'ST' : 'DX'}</span>
      <span data-slot="difficulty" class:list={['difficulty-badge', `difficulty-${item?.difficulty.toLowerCase().replace(':', '')}`]}>{item?.difficulty}</span>
      <span data-slot="level">Lv {item?.level}{item?.constant !== null && item?.constant !== undefined ? ` · ${item.constant.toFixed(1)}` : ''}</span>
    </div>
  </div>
  <div class="recommendation-score">
    <strong data-slot="achievement">{item?.achievement !== null && item?.achievement !== undefined ? `${percentage(item.achievement)}%` : 'No record'}</strong>
    <small data-slot="reason">{item ? recommendationReason(item) : ''}</small>
  </div>
  <div class="recommendation-patterns" data-slot="skills" hidden={!item?.skills.length}>
    {item?.skills.map((skill) => <span>{STUDY_SKILLS[skill as keyof typeof STUDY_SKILLS]}</span>)}
  </div>
  <details class="recommendation-evidence" hidden={!item?.note && !item?.references.length}>
    <summary>Evidence</summary>
    <p data-slot="note" hidden={!item?.note}>{item?.note}</p>
    <a data-slot="source" href={item?.source?.url} target="_blank" rel="noopener noreferrer" hidden={!item?.source}>{item?.source?.name}<ArrowUpRight size={13} /></a>
    <p class="recommendation-reference-label" data-slot="reference-label" hidden={!item?.references.length}>Comparable SSS+ records</p>
    <ul data-slot="references">
      {item?.references.map((reference) => <li><a href={`${base}/songs/${reference.songId}/`}>{reference.title.trim() || 'Untitled'} · {reference.type === 'STANDARD' ? 'ST' : 'DX'} {reference.difficulty} · {reference.constant.toFixed(1)} · {percentage(reference.achievement)}%</a></li>)}
    </ul>
    <p data-slot="shared" hidden={!item?.sharedSkills.length}>Shared patterns: {item?.sharedSkills.map((skill) => STUDY_SKILLS[skill as keyof typeof STUDY_SKILLS]).join(', ')}</p>
  </details>
  <div class="recommendation-actions">
    <a data-slot="song-link" href={songUrl}>Chart<ArrowUpRight size={14} /></a>
    <a data-slot="youtube" class="recommendation-icon" href={item ? buildMaimaiYoutubeUrl(item.title, item.type, item.difficulty) : '#'} title="Search this chart on YouTube" aria-label="Search this chart on YouTube" target="_blank" rel="noopener noreferrer"><Play size={17} /></a>
    <a data-slot="planner" class="recommendation-icon" href={item ? plannerRecommendationUrl(base, item.id) : '#'} title="Plan SSS+ attempt" aria-label="Plan SSS+ attempt"><CalendarPlus size={17} /></a>
  </div>
</article>
