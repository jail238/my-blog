---
import SongArtwork from '../../components/SongArtwork.astro';
import SongChartBoard from '../../components/SongChartBoard.astro';
import type { ChartType } from '../../data/maimai';
import { SONGS, chartsForSong, versionGroupsForSong } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return SONGS.map((song) => ({
		params: { song: song.id },
		props: { song },
	}));
}

const { song } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const charts = chartsForSong(song.id);
const versionGroups = versionGroupsForSong(song.id);
const chartGroups = (['STANDARD', 'DX'] satisfies ChartType[])
	.map((type) => ({ type, charts: charts.filter((chart) => chart.type === type) }))
	.filter((group) => group.charts.length > 0);
---

<CatalogLayout title={`${song.title} | ${SITE_TITLE}`} description={`${song.title} maimai 채보 및 기록`} pageClass="song-detail-page">
	<nav class="catalog-breadcrumb" aria-label="현재 위치">
		<a href={`${base}/versions/`}>버전 순</a>
		<span aria-hidden="true">/</span>
		<strong>{song.title}</strong>
	</nav>

	<header class="song-detail-header">
		<SongArtwork song={song} />
		<div>
			<p class="catalog-kicker">{song.genre}</p>
			<h1>{song.title}</h1>
			<p class="song-artist">{song.artist}</p>
			<div class="song-version-links" aria-label="채보별 수록 버전">
				{versionGroups.map(({ version, types }) => (
					<a class="song-version-link" href={`${base}/versions/${version.id}/`}>
						<span>{types.map((type) => type === 'STANDARD' ? 'ST' : 'DX').join(' · ')}</span>
						{version.shortName}
					</a>
				))}
			</div>
		</div>
	</header>

	<div class="song-detail-grid">
		<section class="song-chart-section" aria-labelledby="chart-heading">
			<div class="catalog-section-heading">
				<div>
					<p class="catalog-kicker">CHARTS</p>
					<h2 id="chart-heading">채보</h2>
				</div>
			</div>
			{
				chartGroups.length > 0 ? (
					<div class="song-chart-groups">
						{chartGroups.map((group) => <SongChartBoard type={group.type} charts={group.charts} />)}
					</div>
				) : (
					<div class="catalog-empty compact"><strong>등록된 채보가 없습니다.</strong></div>
				)
			}
		</section>

	</div>
</CatalogLayout>
