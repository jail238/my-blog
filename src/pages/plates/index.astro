---
import { PLATE_GOALS, PLATE_GROUPS, plateProgress } from '../../data/plates';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

const progress = PLATE_GROUPS.map(plateProgress);
---

<CatalogLayout
	title={`플레이트작 | ${SITE_TITLE}`}
	description="maimai 버전 플레이트 달성 진행도"
	pageClass="plate-index-page"
>
	<header class="catalog-page-header">
		<p class="catalog-kicker">PLATE PROGRESS</p>
		<h1>플레이트작</h1>
		<p>{PLATE_GROUPS.length} VERSION GROUPS · BASIC–MASTER</p>
	</header>

	<section class="plate-criteria" aria-label="플레이트 달성 조건">
		{PLATE_GOALS.map((goal) => (
			<div class:list={['plate-criterion', `plate-goal-${goal.id}`]}>
				<strong>{goal.suffix}</strong>
				<span>{goal.shortLabel}</span>
				<small>{goal.condition}</small>
			</div>
		))}
	</section>

	<p class="plate-scope">현재 국제판 CiRCLE PLUS 수록 기준 · Re:MASTER 제외</p>

	<section class="plate-index-list" aria-label="버전 플레이트 진행도">
		{progress.map(({ group, totalCount, goals }) => (
			<article class="plate-version-row">
				<header class="plate-version-heading">
					<span class="plate-prefix" aria-hidden="true">{group.prefix}</span>
					<span>
						<strong>{group.name}</strong>
						<small>{totalCount} CHARTS</small>
					</span>
				</header>
				<div class="plate-goal-grid">
					{goals.map(({ goal, available, completedCount, complete, rate }) => (
						<div
							class:list={[
								'plate-goal-progress',
								`plate-goal-${goal.id}`,
								{ 'is-complete': complete, 'is-unavailable': !available },
							]}
							style={`--plate-progress: ${rate.toFixed(2)}%`}
							title={available ? `${group.prefix}${goal.suffix} ${completedCount}/${totalCount}` : `${group.prefix}${goal.suffix} 없음`}
						>
							<span>
								<strong>{group.prefix}{goal.suffix}</strong>
								<small>{available ? goal.shortLabel : '해당 없음'}</small>
							</span>
							<b>{available ? `${completedCount}/${totalCount}` : '—'}</b>
						</div>
					))}
				</div>
			</article>
		))}
	</section>

	<p class="plate-note">maimai와 maimai PLUS는 하나의 真 플레이트 범위이며 真将은 존재하지 않습니다.</p>
</CatalogLayout>
