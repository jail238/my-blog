---
import { PLATE_GOAL, PLATE_GROUPS, plateProgress } from '../../data/plates';
import { versionById } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const progress = PLATE_GROUPS.map((group) => ({
	...plateProgress(group),
	versions: group.versionIds
		.map((versionId) => versionById.get(versionId))
		.filter((version) => version !== undefined),
}));
---

<CatalogLayout
	title={`플레이트 | ${SITE_TITLE}`}
	description="maimai 버전 神 플레이트 달성 진행도"
	pageClass="plate-index-page"
>
	<header class="catalog-page-header">
		<p class="catalog-kicker">PLATE PROGRESS</p>
		<h1>플레이트</h1>
		<p>{PLATE_GROUPS.length} PLATES</p>
	</header>

	<section class="plate-progress-list" aria-label="플레이트 진행도">
		{progress.map(({ group, versions, totalCount, completedCount, complete, rate }) => (
			<article class:list={['plate-progress-item', { 'is-complete': complete }]}>
				<div class="plate-art">
					<img
						src={`${base}/assets/maimai/plate/${group.assetId}.png`}
						alt={`${group.prefix}${PLATE_GOAL.suffix} 플레이트`}
						width="720"
						height="116"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="plate-progress-copy">
					<header class="plate-progress-heading">
						<span class="plate-version-copy">
							<span class="plate-version-links">
								{group.displayName ? (
									<span class="plate-version-range">{group.displayName}</span>
								) : (
									versions.map((version, index) => (
										<>
											{index > 0 && <span class="plate-version-separator" aria-hidden="true">/</span>}
											<a
												href={`${base}/versions/${version.id}/`}
												aria-label={`${version.shortName} 버전 채보 보기`}
											>
												{version.shortName}<span aria-hidden="true">›</span>
											</a>
										</>
									))
								)}
							</span>
							<small>{totalCount} CHARTS{group.includeReMaster && ' · BASIC–Re:MASTER'}</small>
						</span>
					</header>
					<div class="plate-progress-summary">
						<strong>플레이트 진행 상황</strong>
						<span>{completedCount}/{totalCount}</span>
						<b>{rate.toFixed(1)}%</b>
					</div>
					<div
						class="plate-progress-track"
						role="progressbar"
						aria-label={`${group.prefix}${PLATE_GOAL.suffix} 진행률`}
						aria-valuemin="0"
						aria-valuemax="100"
						aria-valuenow={rate.toFixed(1)}
					>
						<span style={`width: ${rate.toFixed(2)}%`}></span>
					</div>
				</div>
			</article>
		))}
	</section>
</CatalogLayout>
