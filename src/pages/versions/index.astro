---
import { CHARTS, songsForVersion, versionsNewestFirst } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const versionProgress = versionsNewestFirst.map((version) => {
	const charts = CHARTS.filter((chart) => chart.versionId === version.id);
	const apCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;

	return {
		version,
		apCount,
		totalCount: charts.length,
		apRate: charts.length > 0 ? (apCount / charts.length) * 100 : 0,
		songCount: songsForVersion(version.id).length,
	};
});
---

<CatalogLayout title={`Version | ${SITE_TITLE}`} description="maimai songs organized by version" pageClass="version-index-page">
	<header class="catalog-page-header">
		<p class="catalog-kicker">VERSION INDEX</p>
		<h1>Version</h1>
		<p>{versionsNewestFirst.length} VERSIONS</p>
	</header>

	<section class="version-index-list" id="version-index-list" aria-label="Version list">
		{versionProgress.map(({ version, apCount, totalCount, apRate, songCount }) => {
			return (
				<a
					href={`${base}/versions/${version.id}/`}
					style={`--ap-progress: ${apRate.toFixed(2)}%`}
					title={`AP / AP+ ${apCount}/${totalCount}`}
				>
					<span class="version-sequence">{String(version.order).padStart(2, '0')}</span>
					<span class="version-name">
						<strong>{version.shortName}</strong>
						<small>{version.name}</small>
					</span>
					<span class="version-index-meta">
						<b>{apCount}/{totalCount}</b>
						<span aria-hidden="true">·</span>
						<span class:list={['version-count', { empty: songCount === 0 }]}>{songCount} songs</span>
					</span>
					<span class="version-arrow" aria-hidden="true">›</span>
				</a>
			);
		})}
	</section>
</CatalogLayout>
