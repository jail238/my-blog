---
import SongRow from '../../components/SongRow.astro';
import CatalogSearch from '../../components/CatalogSearch.astro';
import { chartsForSongVersion, VERSIONS, songsForVersion } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return VERSIONS.map((version) => ({
		params: { version: version.id },
		props: { version },
	}));
}

const { version } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const songs = songsForVersion(version.id);
---

<CatalogLayout title={`${version.shortName} | ${SITE_TITLE}`} description={`${version.name} 수록곡 목록`} pageClass="version-detail-page">
	<nav class="catalog-breadcrumb" aria-label="현재 위치">
		<a href={`${base}/versions/`}>버전 순</a>
		<span aria-hidden="true">/</span>
		<strong>{version.shortName}</strong>
	</nav>

	<header class="catalog-page-header version-heading">
		<p class="catalog-kicker">VERSION {String(version.order).padStart(2, '0')}</p>
		<h1>{version.shortName}</h1>
		<p>{songs.length} SONGS</p>
	</header>

	{
		songs.length > 0 ? (
			<>
				<CatalogSearch
					id="version-songs"
					targetId="version-song-list"
					placeholder="곡명 또는 아티스트"
					initialCount={songs.length}
					sortLabel="곡명 순"
					emptyMessage="조건에 맞는 곡이 없습니다."
				/>
				<section class="song-list" id="version-song-list" aria-label={`${version.shortName} 수록곡`}>
					{songs.map((song) => (
						<SongRow song={song} charts={chartsForSongVersion(song.id, version.id)} />
					))}
				</section>
			</>
		) : (
			<section class="catalog-empty">
				<strong>등록된 곡이 없습니다.</strong>
			</section>
		)
	}
</CatalogLayout>
