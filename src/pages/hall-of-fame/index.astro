---
import HallChart from '../../components/HallChart.astro';
import { ChevronDown, ChevronsUpDown, ChevronsDownUp } from '@lucide/astro';
import { CHARTS } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';
import { hallOfFameGroups } from '../../utils/hall-of-fame.js';
import '../../styles/hall-of-fame.css';

const groups = hallOfFameGroups(CHARTS);
const perfectCount = groups.reduce((sum, group) => sum + group.perfectCharts.length, 0);
const totalCount = groups.reduce((sum, group) => sum + group.totalCount, 0);
---

<CatalogLayout title={`Hall of Fame | ${SITE_TITLE}`} description="AP and AP+ chart achievements by internal level, from 1.0 to 15.0." pageClass="hall-page">
	<header class="catalog-page-header">
		<p class="catalog-kicker">AP / AP+</p>
		<h1>Hall of Fame</h1>
		<p>{perfectCount.toLocaleString('en-US')}/{totalCount.toLocaleString('en-US')}</p>
	</header>

	<div class="hall-controls" role="group" aria-label="Hall of Fame controls" hidden>
		<button class="hall-action" id="hall-expand-all" type="button" aria-controls="hall-collection"><ChevronsUpDown size={16} aria-hidden="true" />Expand all</button>
		<button class="hall-action" id="hall-collapse-all" type="button" aria-controls="hall-collection"><ChevronsDownUp size={16} aria-hidden="true" />Collapse all</button>
		<label class="hall-visibility">
			<span>Show unachieved</span>
			<input id="hall-show-unachieved" type="checkbox" role="switch" aria-label="Show unachieved" aria-controls="hall-collection" />
			<span data-hall-visibility-label aria-hidden="true">OFF</span>
		</label>
	</div>

	<div class="hall-collection" id="hall-collection" data-show-unachieved="false">
		{groups.map(({ constant, level, totalCount, perfectCharts, unachievedCharts }) => (
			<details class="hall-group" aria-labelledby={`constant-${Math.round(constant * 10)}`} data-constant={constant.toFixed(1)}>
				<summary class="hall-group-heading">
					<h2 id={`constant-${Math.round(constant * 10)}`}>
						<span>{constant.toFixed(1)}</span>
						<span class="hall-level">Lv {level}</span>
						<span class="hall-count" aria-label={`${perfectCharts.length} of ${totalCount} charts achieved AP or AP+`}>{perfectCharts.length}/{totalCount}</span>
						<ChevronDown class="hall-toggle-icon" aria-hidden="true" />
					</h2>
				</summary>
				<div class="hall-jackets" data-perfect-count={perfectCharts.length}>
					{perfectCharts.map((chart) => <HallChart chart={chart} constant={constant} />)}
				</div>
				{unachievedCharts.length > 0 && (
					<template data-hall-unachieved>
						{unachievedCharts.map((chart) => <HallChart chart={chart} constant={constant} />)}
					</template>
				)}
			</details>
		))}
	</div>
</CatalogLayout>

<script>
	import { initializeHallOfFame } from '../../scripts/hall-of-fame.js';
	initializeHallOfFame(document.querySelector('.hall-page'));
</script>
