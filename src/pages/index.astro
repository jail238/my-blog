---
import { Image } from 'astro:assets';
import archiveCover from '../assets/archive-rooftop.webp';
import archiveCity from '../assets/archive-city.webp';
import SongArtwork from '../components/SongArtwork.astro';
import ComboIcon from '../components/ComboIcon.astro';
import { ArrowUpRight, ChartNoAxesColumnIncreasing, Layers3, Disc3, Award, RefreshCw, ArrowRight } from '@lucide/astro';
import {
	CHARTS,
	DIFFICULTIES,
	PERFECT_RECORDED_CHARTS,
	PLAYER_PROFILE,
	SONGS,
	registeredLevels,
	songById,
	songsForVersion,
	versionsNewestFirst,
} from '../data/maimai';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { PLATE_GROUPS, plateProgress } from '../data/plates';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levelOrder = registeredLevels().slice().reverse();
const levelProgress = levelOrder.map((level) => {
	const charts = CHARTS.filter((chart) => chart.level === level);
	const apCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;
	return {
		level,
		apCount,
		totalCount: charts.length,
		apRate: charts.length > 0 ? (apCount / charts.length) * 100 : 0,
	};
});
const versionProgress = versionsNewestFirst.map((version) => {
	const charts = CHARTS.filter((chart) => chart.versionId === version.id);
	const apCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;
	return {
		version,
		apCount,
		totalCount: charts.length,
		apRate: charts.length > 0 ? (apCount / charts.length) * 100 : 0,
		songCount: songsForVersion(version.id).length,
	};
});
const plateGroupProgress = PLATE_GROUPS.map(plateProgress);
const completedPlateCount = plateGroupProgress.filter(({ complete }) => complete).length;
const recordedCharts = PERFECT_RECORDED_CHARTS
	.slice(0, 12)
	.map((chart) => ({ chart, song: songById.get(chart.songId) }))
	.filter((entry) => entry.song !== undefined);
---

<CatalogLayout title={SITE_TITLE} description={SITE_DESCRIPTION} pageClass="maimai-home">
	<section class="archive-cover" aria-labelledby="archive-title">
		<template data-archive-cover="rooftop">
			<Image
				src={archiveCover}
				alt="A quiet rooftop at night, with a woman looking at her phone between apartment buildings."
				class="archive-cover-image"
				widths={[640, 960, 1584]}
				sizes="100vw"
				quality={88}
				loading="eager"
				fetchpriority="high"
			/>
		</template>
		<template data-archive-cover="city">
			<Image
				src={archiveCity}
				alt="A black-and-white rooftop illustration of a woman overlooking the city at night."
				class="archive-cover-image"
				widths={[640, 960, 1584]}
				sizes="100vw"
				quality={88}
				loading="eager"
				fetchpriority="high"
			/>
		</template>
		<noscript>
			<Image
				src={archiveCover}
				alt="A quiet rooftop at night, with a woman looking at her phone between apartment buildings."
				class="archive-cover-image"
				widths={[640, 960, 1584]}
				sizes="100vw"
				quality={88}
				loading="eager"
				fetchpriority="high"
			/>
		</noscript>
		<script is:inline>
			(() => {
				const cover = document.currentScript.closest('.archive-cover');
				const templates = [...cover.querySelectorAll('template[data-archive-cover]')];
				const storageKey = 'msk.archive-cover';
				let previous;
				try { previous = sessionStorage.getItem(storageKey); } catch {}
				const remaining = templates.filter((template) => template.dataset.archiveCover !== previous);
				const choices = remaining.length ? remaining : templates;
				if (!choices.length) return;
				const selected = choices[Math.floor(Math.random() * choices.length)];
				cover.prepend(selected.content.cloneNode(true));
				cover.dataset.cover = selected.dataset.archiveCover;
				try { sessionStorage.setItem(storageKey, selected.dataset.archiveCover); } catch {}
			})();
		</script>
		<div class="home-section-inner cover-layout">
			<div class="cover-copy">
				<h1 id="archive-title">M.S.K.</h1>
				<p>maimai Record Archive</p>
			</div>
			<div class="profile-metrics" aria-label="Record summary">
				<span><small>RATING</small><strong data-profile-metric="rating">{PLAYER_PROFILE.rating.toLocaleString('en-US')}</strong></span>
				<span><small>CLASS</small><strong data-profile-metric="className">B4</strong></span>
				<span><small>COINS</small><strong data-profile-metric="playCount">{PLAYER_PROFILE.playCount.toLocaleString('en-US')}</strong></span>
			</div>
		</div>
	</section>

	<nav class="archive-modes home-section-inner" aria-label="Archive categories">
		<a href={`${base}/levels/`}>
			<ChartNoAxesColumnIncreasing class="mode-icon" aria-hidden="true" />
			<strong>Level</strong>
			<small>{CHARTS.length} CHARTS</small>
			<ArrowUpRight class="mode-arrow" aria-hidden="true" />
		</a>
		<a href={`${base}/difficulties/`}>
			<Layers3 class="mode-icon" aria-hidden="true" />
			<strong>Difficulty</strong>
			<small>{DIFFICULTIES.length} DIFFICULTIES</small>
			<ArrowUpRight class="mode-arrow" aria-hidden="true" />
		</a>
		<a href={`${base}/versions/`}>
			<Disc3 class="mode-icon" aria-hidden="true" />
			<strong>Version</strong>
			<small>{SONGS.length} SONGS</small>
			<ArrowUpRight class="mode-arrow" aria-hidden="true" />
		</a>
		<a href={`${base}/plates/`}>
			<Award class="mode-icon" aria-hidden="true" />
			<strong>Plate</strong>
			<small data-completed-plates>{completedPlateCount}/{PLATE_GROUPS.length} 神</small>
			<ArrowUpRight class="mode-arrow" aria-hidden="true" />
		</a>
	</nav>

	<div class="archive-overview home-section-inner">
		<section class="overview-block" aria-labelledby="level-overview-title">
			<div class="catalog-section-heading">
				<div>
					<p class="catalog-kicker">LEVEL INDEX</p>
					<h2 id="level-overview-title">Level</h2>
				</div>
				<a href={`${base}/levels/`}>All <ArrowRight size={16} aria-hidden="true" /></a>
			</div>
			<div class="home-index-scroll" role="region" aria-label="All levels" tabindex="0">
				<div class="level-quick-grid">
					{levelProgress.map(({ level, apCount, totalCount, apRate }) => (
						<a
							data-record-progress="level" data-progress-value={level}
							href={`${base}/levels/${level.replace('+', '-plus')}/`}
							style={`--ap-progress: ${apRate.toFixed(2)}%`}
							title={`AP / AP+ ${apCount}/${totalCount}`}
						>
							<strong>{level}</strong>
							<small data-progress-count>{apCount}/{totalCount}</small>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="overview-block" aria-labelledby="version-overview-title">
			<div class="catalog-section-heading">
				<div>
					<p class="catalog-kicker">VERSION INDEX</p>
					<h2 id="version-overview-title">Version</h2>
				</div>
				<a href={`${base}/versions/`}>All <ArrowRight size={16} aria-hidden="true" /></a>
			</div>
			<div class="home-index-scroll" role="region" aria-label="All versions" tabindex="0">
				<div class="version-quick-list">
					{versionProgress.map(({ version, apCount, totalCount, apRate, songCount }) => (
						<a
							data-record-progress="versionId" data-progress-value={version.id}
							href={`${base}/versions/${version.id}/`}
							style={`--ap-progress: ${apRate.toFixed(2)}%`}
							title={`AP / AP+ ${apCount}/${totalCount}`}
						>
							<span>{version.shortName}</span>
							<small><b data-progress-count>{apCount}/{totalCount}</b> · {songCount} songs</small>
						</a>
					))}
				</div>
			</div>
		</section>
	</div>

	<section class="record-gallery" aria-labelledby="record-gallery-title">
		<div class="home-section-inner">
		<div class="catalog-section-heading">
			<div>
				<p class="catalog-kicker">REGISTERED RECORDS</p>
				<h2 id="record-gallery-title">Records</h2>
			</div>
			<div class="record-gallery-heading-meta">
				<span>{PERFECT_RECORDED_CHARTS.length.toLocaleString('en-US')} CHARTS</span>
				<a href={`${base}/records/`}>All <ArrowRight size={16} aria-hidden="true" /></a>
				<a
					class="record-refresh-button compact"
					href={`${base}/sync/`}
					title="Import records from maimai DX NET"
					><RefreshCw size={14} aria-hidden="true" />Refresh records</a>
			</div>
		</div>
		<div class="record-gallery-grid">
			{recordedCharts.map(({ song, chart }) => song && (
				<a href={`${base}/songs/${song.id}/`}>
					<SongArtwork song={song} compact />
					<span class="record-copy">
						<strong>{song.title}</strong>
						<small>{chart.type === 'STANDARD' ? 'ST' : 'DX'} · {chart.difficulty} · Lv {chart.level}</small>
					</span>
					<span class="record-score">
						<span class="record-score-copy">
							<strong>{chart.record?.achievement}</strong>
							<small>{chart.record?.rank}{chart.record?.combo ? ` · ${chart.record.combo}` : ''}</small>
						</span>
						<ComboIcon combo={chart.record?.combo} />
					</span>
				</a>
			))}
		</div>
		</div>
	</section>
</CatalogLayout>
