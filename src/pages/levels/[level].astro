---
import ChartRow from '../../components/ChartRow.astro';
import { chartsForLevel, levelToSlug, registeredLevels, songById, versionsNewestFirst } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return registeredLevels().map((level) => ({
		params: { level: levelToSlug(level) },
		props: { level },
	}));
}

const { level } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const charts = chartsForLevel(level);
const perfectCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;
const levels = registeredLevels().slice().reverse();
const internalLevels = [...new Set(
	charts
		.map((chart) => chart.constant)
		.filter((constant): constant is number => constant !== undefined)
		.map((constant) => constant.toFixed(1)),
)].sort((a, b) => Number(a) - Number(b));
---

<CatalogLayout title={`LEVEL ${level} | ${SITE_TITLE}`} description={`maimai LEVEL ${level} 채보 목록`} pageClass="level-detail-page">
	<nav class="catalog-breadcrumb" aria-label="현재 위치">
		<a href={`${base}/levels/`}>레벨 순</a>
		<span aria-hidden="true">/</span>
		<strong>{level}</strong>
	</nav>

	<header class="catalog-page-header compact">
		<p class="catalog-kicker">LEVEL</p>
		<h1>{level}</h1>
		<p>{charts.length} CHARTS · {perfectCount}/{charts.length}</p>
	</header>

	<nav class="level-strip" aria-label="다른 레벨">
		{levels.map((item) => (
			<a class:list={{ active: item === level }} href={`${base}/levels/${levelToSlug(item)}/`}>{item}</a>
		))}
	</nav>

	<form class="record-filters level-chart-filters" id="level-chart-filters">
		<label class="record-search">
			<span>검색</span>
			<input id="level-chart-query" type="search" placeholder="곡명 또는 아티스트" autocomplete="off" />
		</label>
		<label>
			<span>채보</span>
			<select id="level-chart-type">
				<option value="">전체</option>
				<option value="STANDARD">ST</option>
				<option value="DX">DX</option>
			</select>
		</label>
		<label>
			<span>난이도</span>
			<select id="level-chart-difficulty">
				<option value="">전체</option>
				<option value="BASIC">BASIC</option>
				<option value="ADVANCED">ADVANCED</option>
				<option value="EXPERT">EXPERT</option>
				<option value="MASTER">MASTER</option>
				<option value="Re:MASTER">Re:MASTER</option>
			</select>
		</label>
		<label>
			<span>내부 레벨</span>
			<select id="level-chart-constant">
				<option value="">전체</option>
				{internalLevels.map((constant) => <option value={constant}>{constant}</option>)}
			</select>
		</label>
		<label>
			<span>버전</span>
			<select id="level-chart-version">
				<option value="">전체</option>
				{versionsNewestFirst.map((version) => <option value={version.id}>{version.shortName}</option>)}
			</select>
		</label>
		<label class="record-checkbox">
			<input id="level-chart-include-perfect" type="checkbox" checked />
			<span>AP/AP+ 완료 포함</span>
		</label>
		<button type="reset">초기화</button>
	</form>

	<div class="record-result-bar" aria-live="polite">
		<strong id="level-chart-count">{charts.length.toLocaleString('ko-KR')}개</strong>
		<span>AP+ · AP · 달성률 순</span>
	</div>

	<section class="chart-list" id="level-chart-list" aria-label={`LEVEL ${level} 채보`}>
		{charts.map((chart) => {
			const song = songById.get(chart.songId);
			return song && <ChartRow chart={chart} song={song} />;
		})}
	</section>
	<div class="catalog-empty compact" id="level-chart-empty" hidden><strong>조건에 맞는 채보가 없습니다.</strong></div>
</CatalogLayout>

<script>
	const form = document.querySelector('#level-chart-filters');
	const queryInput = document.querySelector('#level-chart-query');
	const typeSelect = document.querySelector('#level-chart-type');
	const difficultySelect = document.querySelector('#level-chart-difficulty');
	const constantSelect = document.querySelector('#level-chart-constant');
	const versionSelect = document.querySelector('#level-chart-version');
	const includePerfectInput = document.querySelector('#level-chart-include-perfect');
	const list = document.querySelector('#level-chart-list');
	const count = document.querySelector('#level-chart-count');
	const empty = document.querySelector('#level-chart-empty');
	const rows = [...document.querySelectorAll<HTMLElement>('#level-chart-list .chart-row')];

	function applyFilters() {
		if (!(queryInput instanceof HTMLInputElement)) return;
		if (!(typeSelect instanceof HTMLSelectElement)) return;
		if (!(difficultySelect instanceof HTMLSelectElement)) return;
		if (!(constantSelect instanceof HTMLSelectElement)) return;
		if (!(versionSelect instanceof HTMLSelectElement)) return;
		if (!(includePerfectInput instanceof HTMLInputElement)) return;

		const query = queryInput.value.trim().toLocaleLowerCase('ko');
		const matches = rows.filter((row) =>
			(!query || row.dataset.search?.includes(query)) &&
			(!typeSelect.value || row.dataset.type === typeSelect.value) &&
			(!difficultySelect.value || row.dataset.difficulty === difficultySelect.value) &&
			(!constantSelect.value || row.dataset.constant === constantSelect.value) &&
			(!versionSelect.value || row.dataset.version === versionSelect.value) &&
			(includePerfectInput.checked || row.dataset.perfect !== 'true'),
		);
		const matchSet = new Set(matches);

		for (const row of rows) row.hidden = !matchSet.has(row);
		if (list instanceof HTMLElement) list.hidden = matches.length === 0;
		if (count) count.textContent = `${matches.length.toLocaleString('ko-KR')}개`;
		if (empty instanceof HTMLElement) empty.hidden = matches.length > 0;
	}

	form?.addEventListener('input', applyFilters);
	form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
	applyFilters();
</script>
