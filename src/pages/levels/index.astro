---
import CatalogSearch from '../../components/CatalogSearch.astro';
import { CATALOG_SOURCE, CHARTS, registeredLevels } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levels = registeredLevels().slice().reverse();
---

<CatalogLayout title={`레벨 순 | ${SITE_TITLE}`} description="maimai 채보를 레벨 순으로 정리한 아카이브" pageClass="level-index-page">
	<header class="catalog-page-header">
		<p class="catalog-kicker">LEVEL INDEX</p>
		<h1>레벨 순</h1>
		<p>{CHARTS.length} CHARTS · {CATALOG_SOURCE.gameVersion}</p>
	</header>

	<div class="chart-type-key page-key" aria-label="채보 유형">
		<span><b class="type-badge type-standard">ST</b> STANDARD</span>
		<span><b class="type-badge type-dx">DX</b> DELUXE</span>
	</div>

	<CatalogSearch
		id="level-index"
		targetId="level-index-list"
		placeholder="레벨"
		initialCount={levels.length}
		sortLabel="높은 레벨 순"
		emptyMessage="조건에 맞는 레벨이 없습니다."
	/>

	<section class="level-index-grid" id="level-index-list" aria-label="레벨 목록">
		{levels.map((level) => (
			<a href={`${base}/levels/${level.replace('+', '-plus')}/`} data-search={level.toLocaleLowerCase('ko')}>
				<span>LEVEL</span>
				<strong>{level}</strong>
				<small>{CHARTS.filter((chart) => chart.level === level).length} CHARTS</small>
			</a>
		))}
	</section>
</CatalogLayout>
