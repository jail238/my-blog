---
import { CHARTS, DIFFICULTIES, difficultyToSlug } from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const difficultyProgress = DIFFICULTIES.map((difficulty) => {
	const charts = CHARTS.filter((chart) => chart.difficulty === difficulty);
	const apCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;
	return {
		difficulty,
		slug: difficultyToSlug(difficulty),
		apCount,
		totalCount: charts.length,
		apRate: charts.length > 0 ? (apCount / charts.length) * 100 : 0,
	};
});
---

<CatalogLayout title={`Difficulty | ${SITE_TITLE}`} description="maimai charts organized by difficulty" pageClass="difficulty-index-page">
	<header class="catalog-page-header">
		<p class="catalog-kicker">DIFFICULTY INDEX</p>
		<h1>Difficulty</h1>
		<p>{DIFFICULTIES.length} DIFFICULTIES · {CHARTS.length} CHARTS</p>
	</header>

	<section class="difficulty-index-grid" aria-label="Difficulty list">
		{difficultyProgress.map(({ difficulty, slug, apCount, totalCount, apRate }) => (
			<a
				data-record-progress="difficulty" data-progress-value={difficulty} data-progress-percent="true"
				class:list={['difficulty-index-card', `difficulty-tone-${slug}`]}
				href={`${base}/difficulties/${slug}/`}
				style={`--ap-progress: ${apRate.toFixed(2)}%`}
				title={`AP / AP+ ${apCount}/${totalCount} (${apRate.toFixed(1)}%)`}
			>
				<span>DIFFICULTY</span>
				<strong>{difficulty}</strong>
				<small data-progress-count>{apCount}/{totalCount} ({apRate.toFixed(1)}%)</small>
			</a>
		))}
	</section>
</CatalogLayout>
