---
import { ChevronsUpDown, List, LayoutGrid, ArrowLeft, ArrowRight } from '@lucide/astro';
import ChartRow from '../../components/ChartRow.astro';
import {
	DIFFICULTIES,
	chartsForDifficulty,
	difficultyToSlug,
	registeredLevels,
	songById,
	versionsNewestFirst,
	type Difficulty,
} from '../../data/maimai';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return DIFFICULTIES.map((difficulty) => ({
		params: { difficulty: difficultyToSlug(difficulty) },
		props: { difficulty },
	}));
}

interface Props {
	difficulty: Difficulty;
}

const { difficulty } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = difficultyToSlug(difficulty);
const charts = chartsForDifficulty(difficulty);
const perfectCount = charts.filter((chart) => chart.record?.combo === 'AP' || chart.record?.combo === 'AP+').length;
const levels = registeredLevels().slice().reverse();
---

<CatalogLayout title={`${difficulty} | ${SITE_TITLE}`} description={`maimai ${difficulty} chart list`} pageClass="difficulty-detail-page">
	<nav class="catalog-breadcrumb" aria-label="Breadcrumb">
		<a href={`${base}/difficulties/`}>Difficulty</a>
		<span aria-hidden="true">/</span>
		<strong>{difficulty}</strong>
	</nav>

	<header class:list={['catalog-page-header', 'compact', 'difficulty-detail-heading', `difficulty-tone-${slug}`]}>
		<p class="catalog-kicker">DIFFICULTY</p>
		<h1>{difficulty}</h1>
		<p>{charts.length} CHARTS · {perfectCount}/{charts.length}</p>
	</header>

	<nav class="level-strip difficulty-strip" aria-label="Other difficulties">
		{DIFFICULTIES.map((item) => (
			<a
				class:list={{ active: item === difficulty }}
				href={`${base}/difficulties/${difficultyToSlug(item)}/`}
			>{item}</a>
		))}
	</nav>

	<form class="record-filters difficulty-chart-filters" id="difficulty-chart-filters">
		<label class="record-search">
			<span>Search</span>
			<input id="difficulty-chart-query" type="search" placeholder="Song title or artist" autocomplete="off" />
		</label>
		<label>
			<span>Chart type</span>
			<select id="difficulty-chart-type">
				<option value="">All</option>
				<option value="STANDARD">ST</option>
				<option value="DX">DX</option>
			</select>
		</label>
		<label>
			<span>Level</span>
			<select id="difficulty-chart-level">
				<option value="">All</option>
				{levels.map((level) => <option value={level}>{level}</option>)}
			</select>
		</label>
		<label>
			<span>Version</span>
			<select id="difficulty-chart-version">
				<option value="">All</option>
				{versionsNewestFirst.map((version) => <option value={version.id}>{version.shortName}</option>)}
			</select>
		</label>
		<label class="record-checkbox">
			<input id="difficulty-chart-include-perfect" type="checkbox" checked />
			<span>Include AP/AP+</span>
		</label>
		<button type="reset">Reset</button>
	</form>

	<div class="record-result-bar level-chart-result-bar">
		<strong id="difficulty-chart-count" aria-live="polite">{charts.length.toLocaleString('en-US')} charts</strong>
		<div class="level-chart-result-actions">
			<div class="difficulty-chart-page-size-control">
				<select
					class="difficulty-chart-page-size"
					id="difficulty-chart-page-size"
					aria-label="Items per page"
					title="Items per page"
				>
					<option value="30">Show 30</option>
					<option value="50">Show 50</option>
					<option value="100">Show 100</option>
				</select>
				<ChevronsUpDown class="difficulty-chart-page-size-icon" aria-hidden="true" />
			</div>
			<div class="difficulty-chart-sort-toggle" role="group" aria-label="Sort by">
				<button
					type="button"
					class="difficulty-chart-sort-button"
					data-difficulty-chart-sort-key="ap-plus"
					aria-pressed="false"
					title="Sort by AP+ completion"
				>AP+</button>
				<button
					type="button"
					class="difficulty-chart-sort-button active"
					data-difficulty-chart-sort-key="ap"
					aria-pressed="true"
					title="Sort by AP / AP+ completion"
				>AP</button>
				<button
					type="button"
					class="difficulty-chart-sort-button"
					data-difficulty-chart-sort-key="achievement"
					aria-pressed="false"
					title="Sort by achievement"
				>Rate</button>
				<button
					type="button"
					class="difficulty-chart-sort-button"
					data-difficulty-chart-sort-key="level"
					aria-pressed="false"
					title="Sort by chart constant"
				>Level</button>
			</div>
			<div class="difficulty-chart-direction-toggle" role="group" aria-label="Sort direction">
				<button
					type="button"
					class="difficulty-chart-direction-button active"
					data-difficulty-chart-sort-direction="desc"
					aria-label="Descending; click to sort ascending"
					title="Descending; click to sort ascending"
				>↑</button>
			</div>
			<div class="level-chart-view-toggle" role="group" aria-label="View mode">
				<button
					type="button"
					class="level-chart-view-button active"
					data-difficulty-chart-view="list"
					aria-label="List view"
					aria-controls="difficulty-chart-list"
					aria-pressed="true"
					title="List view"
				>
					<List size={18} aria-hidden="true" />
				</button>
				<button
					type="button"
					class="level-chart-view-button"
					data-difficulty-chart-view="grid"
					aria-label="Grid view"
					aria-controls="difficulty-chart-list"
					aria-pressed="false"
					title="Grid view"
				>
					<LayoutGrid size={18} aria-hidden="true" />
				</button>
			</div>
		</div>
	</div>

	<section class="chart-list" id="difficulty-chart-list" data-view="list" aria-label={`${difficulty} Charts`}>
		{charts.map((chart) => {
			const song = songById.get(chart.songId);
			return song && <ChartRow chart={chart} song={song} />;
		})}
	</section>
	<div class="catalog-empty compact" id="difficulty-chart-empty" hidden><strong>No matching charts.</strong></div>
	<nav class="difficulty-chart-pagination" id="difficulty-chart-pagination" aria-label="Chart pagination">
		<button type="button" id="difficulty-chart-prev" aria-label="Previous page" title="Previous page"><ArrowLeft size={18} aria-hidden="true" /></button>
		<span id="difficulty-chart-page-status" aria-live="polite">1 / 1</span>
		<button type="button" id="difficulty-chart-next" aria-label="Next page" title="Next page"><ArrowRight size={18} aria-hidden="true" /></button>
	</nav>
</CatalogLayout>

<script>
	const form = document.querySelector('#difficulty-chart-filters');
	const queryInput = document.querySelector('#difficulty-chart-query');
	const typeSelect = document.querySelector('#difficulty-chart-type');
	const levelSelect = document.querySelector('#difficulty-chart-level');
	const versionSelect = document.querySelector('#difficulty-chart-version');
	const includePerfectInput = document.querySelector('#difficulty-chart-include-perfect');
	const list = document.querySelector('#difficulty-chart-list');
	const count = document.querySelector('#difficulty-chart-count');
	const empty = document.querySelector('#difficulty-chart-empty');
	const pageSizeSelect = document.querySelector('#difficulty-chart-page-size');
	const pagination = document.querySelector('#difficulty-chart-pagination');
	const previousPageButton = document.querySelector('#difficulty-chart-prev');
	const nextPageButton = document.querySelector('#difficulty-chart-next');
	const pageStatus = document.querySelector('#difficulty-chart-page-status');
	const rows = [...document.querySelectorAll<HTMLElement>('#difficulty-chart-list .chart-row')];
	const originalRowOrder = new Map(rows.map((row, index) => [row, index]));
	const sortKeyButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-difficulty-chart-sort-key]')];
	const sortDirectionButton = document.querySelector<HTMLButtonElement>('[data-difficulty-chart-sort-direction]');
	const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-difficulty-chart-view]')];
	type ChartSortKey = 'ap-plus' | 'ap' | 'achievement' | 'level';
	type ChartSortDirection = 'desc' | 'asc';
	type ChartView = 'list' | 'grid';
	const sortKeyStorageKey = 'misaki-difficulty-chart-sort-key';
	const sortDirectionStorageKey = 'misaki-difficulty-chart-sort-direction';
	const sortPreferenceVersionStorageKey = 'misaki-difficulty-chart-sort-preference-version';
	const sortPreferenceVersion = 'ap-desc-v1';
	const viewStorageKey = 'misaki-level-chart-view';
	const pageSizeStorageKey = 'misaki-difficulty-chart-page-size';
	let activeSortKey: ChartSortKey = 'ap';
	let activeSortDirection: ChartSortDirection = 'desc';
	let orderedRows = [...rows];
	let filteredRows = [...rows];
	let pageSize = 30;
	let currentPage = 1;

	function levelValue(row: HTMLElement) {
		const constant = Number.parseFloat(row.dataset.constant ?? '');
		if (Number.isFinite(constant)) return constant;

		const level = row.dataset.level ?? '';
		const displayedLevel = Number.parseInt(level, 10);
		if (!Number.isFinite(displayedLevel)) return 0;
		return displayedLevel + (level.endsWith('+') ? 0.5 : 0);
	}

	function sortValue(row: HTMLElement, key: ChartSortKey) {
		if (key === 'ap-plus') return row.dataset.apPlus === 'true' ? 1 : 0;
		if (key === 'ap') return row.dataset.ap === 'true' ? 1 : 0;
		if (key === 'level') return levelValue(row);

		const achievement = Number.parseFloat(row.dataset.achievement ?? '');
		return Number.isFinite(achievement) ? achievement : 0;
	}

	function applySort(key: ChartSortKey, direction: ChartSortDirection, persist = true) {
		if (!(list instanceof HTMLElement)) return;
		activeSortKey = key;
		activeSortDirection = direction;
		list.dataset.sortKey = key;
		list.dataset.sortDirection = direction;

		orderedRows = [...rows].sort((a, b) => {
			const difference = direction === 'desc'
				? sortValue(b, key) - sortValue(a, key)
				: sortValue(a, key) - sortValue(b, key);
			if (difference !== 0) return difference;
			return (originalRowOrder.get(a) ?? 0) - (originalRowOrder.get(b) ?? 0);
		});

		for (const row of orderedRows) list.append(row);
		for (const button of sortKeyButtons) {
			const active = button.dataset.difficultyChartSortKey === key;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		}
		if (sortDirectionButton) {
			const isDescending = direction === 'desc';
			const currentLabel = isDescending ? 'descending' : 'ascending';
			const nextLabel = isDescending ? 'ascending' : 'descending';
			sortDirectionButton.dataset.difficultyChartSortDirection = direction;
			sortDirectionButton.textContent = isDescending ? '↑' : '↓';
			sortDirectionButton.setAttribute('aria-label', `${currentLabel}; click to sort ${nextLabel}`);
			sortDirectionButton.title = `${currentLabel}; click to sort ${nextLabel}`;
		}

		if (persist) {
			try {
				localStorage.setItem(sortPreferenceVersionStorageKey, sortPreferenceVersion);
				localStorage.setItem(sortKeyStorageKey, key);
				localStorage.setItem(sortDirectionStorageKey, direction);
			} catch {}
		}

		applyFilters();
	}

	function applyView(view: ChartView, persist = true) {
		if (!(list instanceof HTMLElement)) return;
		list.dataset.view = view;

		for (const button of viewButtons) {
			const active = button.dataset.difficultyChartView === view;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		}

		if (persist) {
			try {
				localStorage.setItem(viewStorageKey, view);
			} catch {}
		}
	}

	function renderPage() {
		const total = filteredRows.length;
		const totalPages = Math.ceil(total / pageSize);
		currentPage = totalPages === 0 ? 1 : Math.min(Math.max(currentPage, 1), totalPages);
		const start = (currentPage - 1) * pageSize;
		const end = Math.min(start + pageSize, total);
		const visibleRows = new Set(filteredRows.slice(start, end));

		for (const row of rows) row.hidden = !visibleRows.has(row);
		if (list instanceof HTMLElement) list.hidden = total === 0;
		if (count) count.textContent = total === 0
			? '0 charts'
			: `${(start + 1).toLocaleString('en-US')}-${end.toLocaleString('en-US')}/${total.toLocaleString('en-US')} charts`;
		if (empty instanceof HTMLElement) empty.hidden = total > 0;
		if (pagination instanceof HTMLElement) pagination.hidden = totalPages <= 1;
		if (pageStatus) pageStatus.textContent = totalPages === 0 ? '0 / 0' : `${currentPage} / ${totalPages}`;
		if (previousPageButton instanceof HTMLButtonElement) previousPageButton.disabled = currentPage <= 1;
		if (nextPageButton instanceof HTMLButtonElement) nextPageButton.disabled = totalPages === 0 || currentPage >= totalPages;
	}

	function applyFilters(resetPage = true) {
		if (!(queryInput instanceof HTMLInputElement)) return;
		if (!(typeSelect instanceof HTMLSelectElement)) return;
		if (!(levelSelect instanceof HTMLSelectElement)) return;
		if (!(versionSelect instanceof HTMLSelectElement)) return;
		if (!(includePerfectInput instanceof HTMLInputElement)) return;

		const query = queryInput.value.trim().toLocaleLowerCase('ko');
		if (resetPage) currentPage = 1;
		filteredRows = orderedRows.filter((row) =>
			(!query || row.dataset.search?.includes(query)) &&
			(!typeSelect.value || row.dataset.type === typeSelect.value) &&
			(!levelSelect.value || row.dataset.level === levelSelect.value) &&
			(!versionSelect.value || row.dataset.version === versionSelect.value) &&
			(includePerfectInput.checked || row.dataset.perfect !== 'true'),
		);
		renderPage();
	}

	function movePage(offset: number) {
		const totalPages = Math.ceil(filteredRows.length / pageSize);
		if (totalPages <= 1) return;
		const nextPage = Math.min(Math.max(currentPage + offset, 1), totalPages);
		if (nextPage === currentPage) return;
		currentPage = nextPage;
		renderPage();
		if (list instanceof HTMLElement) list.scrollIntoView({ block: 'start' });
	}

	form?.addEventListener('input', () => applyFilters());
	form?.addEventListener('reset', () => requestAnimationFrame(() => applyFilters()));
	pageSizeSelect?.addEventListener('change', () => {
		if (!(pageSizeSelect instanceof HTMLSelectElement)) return;
		const nextPageSize = Number.parseInt(pageSizeSelect.value, 10);
		if (nextPageSize !== 30 && nextPageSize !== 50 && nextPageSize !== 100) return;
		pageSize = nextPageSize;
		currentPage = 1;
		try {
			localStorage.setItem(pageSizeStorageKey, String(pageSize));
		} catch {}
		renderPage();
	});
	previousPageButton?.addEventListener('click', () => movePage(-1));
	nextPageButton?.addEventListener('click', () => movePage(1));
	for (const button of sortKeyButtons) {
		button.addEventListener('click', () => {
			const key = button.dataset.difficultyChartSortKey;
			if (key === 'ap-plus' || key === 'ap' || key === 'achievement' || key === 'level') {
				applySort(key, activeSortDirection);
			}
		});
	}
	sortDirectionButton?.addEventListener('click', () => {
		applySort(activeSortKey, activeSortDirection === 'desc' ? 'asc' : 'desc');
	});
	for (const button of viewButtons) {
		button.addEventListener('click', () => {
			const view = button.dataset.difficultyChartView;
			if (view === 'list' || view === 'grid') applyView(view);
		});
	}

	let initialView: ChartView = 'list';
	try {
		if (localStorage.getItem(sortPreferenceVersionStorageKey) === sortPreferenceVersion) {
			const storedSortKey = localStorage.getItem(sortKeyStorageKey);
			const storedSortDirection = localStorage.getItem(sortDirectionStorageKey);
			if (storedSortKey === 'ap-plus' || storedSortKey === 'ap' || storedSortKey === 'achievement' || storedSortKey === 'level') {
				activeSortKey = storedSortKey;
			}
			if (storedSortDirection === 'asc' || storedSortDirection === 'desc') {
				activeSortDirection = storedSortDirection;
			}
		} else {
			localStorage.setItem(sortPreferenceVersionStorageKey, sortPreferenceVersion);
			localStorage.setItem(sortKeyStorageKey, activeSortKey);
			localStorage.setItem(sortDirectionStorageKey, activeSortDirection);
		}
		if (localStorage.getItem(viewStorageKey) === 'grid') initialView = 'grid';
		const storedPageSize = Number.parseInt(localStorage.getItem(pageSizeStorageKey) ?? '', 10);
		if (storedPageSize === 30 || storedPageSize === 50 || storedPageSize === 100) pageSize = storedPageSize;
	} catch {}
	if (pageSizeSelect instanceof HTMLSelectElement) pageSizeSelect.value = String(pageSize);
	applyView(initialView, false);
	applySort(activeSortKey, activeSortDirection, false);
</script>
